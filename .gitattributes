# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source and documentation text files
*.py text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.json text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary image and document assets
*.png binary
*.pdf binary
*.jpg binary
*.jpeg binary
*.npy binary
